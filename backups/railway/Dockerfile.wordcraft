# Restore candidate for the archived WordCraft Railway Bun gateway.
# Never publish this directly: requires an external authenticated HTTPS reverse proxy.
# Based on the SOURCE snapshot pinned to WordCraft v0.5.0, not an upgrade to v0.18.1.
FROM oven/bun:1.4.4-debian
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tar gzip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY wordcraft-legacy-server.ts /app/server.ts
ENV PORT=3000
EXPOSE 3000
USER bun
CMD ["bun", "run", "/app/server.ts"]
